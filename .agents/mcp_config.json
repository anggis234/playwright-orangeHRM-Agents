{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {
        "PATH": ""
      }
    },
    "google-sheets": {
      "command": "npx",
      "args": [
        "-y",
        "@a1-x-tech/mcp-google-sheets"
      ],
      "env": {
        "GOOGLE_SHEETS_CLIENT_ID": "",
        "GOOGLE_SHEETS_CLIENT_SECRET": "",
        "GOOGLE_SHEETS_REFRESH_TOKEN": "",
        "PATH": ""
      }
    }
  }
}
